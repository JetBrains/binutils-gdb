diff --git a/bfd/configure b/bfd/configure
index 2db9f76b9eb..6a0875bda8a 100755
--- a/bfd/configure
+++ b/bfd/configure
@@ -15743,7 +15743,7 @@ selarchs=
 TDEFINES=
 for targ in $target $canon_targets
 do
-    if test $targ = all; then
+    if test $targ = all || true; then
         all_targets=true
 	assocvecs="$assocvecs $targ_defvec $targ_selvecs"
     elif test $targ != plugin; then
diff --git a/gdb/configure b/gdb/configure
index 1531f62f76a..fd7d12d7b07 100755
--- a/gdb/configure
+++ b/gdb/configure
@@ -24945,11 +24945,19 @@ fi
 # configuration.
 gdb_host_obs=posix-hdep.o
 
-if test "${target}" = "${host}"; then
-  gdb_native=yes
-else
-  gdb_native=no
-fi
+case "${host}" in
+  aarch64-*-mingw*)
+    # aarch64-mingw native support not yet available in configure.nat
+    gdb_native=no
+    ;;
+  *)
+    if test "${target}" = "${host}"; then
+      gdb_native=yes
+    else
+      gdb_native=no
+    fi
+    ;;
+esac
 
 . $srcdir/configure.host
 
@@ -25178,7 +25186,14 @@ gdb_osabi=
 targ=$target; . ${srcdir}/configure.tgt
 
 # Fetch the default architecture and default target vector from BFD.
-targ=$target; . $srcdir/../bfd/config.bfd
+case "${host}" in
+  aarch64-*-mingw*)
+    # BFD config not available for aarch64 cross-builds
+    ;;
+  *)
+    targ=$target; . $srcdir/../bfd/config.bfd
+    ;;
+esac
 
 # We only want the first architecture, so strip off the others if
 # there is more than one.
diff --git a/gdb/configure.host b/gdb/configure.host
index 22855cdbdf8..8823b631b4f 100644
--- a/gdb/configure.host
+++ b/gdb/configure.host
@@ -107,6 +107,9 @@ i[34567]86-*-go32*)	gdb_host=go32 ;;
 i[34567]86-*-mingw32*)	gdb_host=mingw
 			gdb_host_obs=mingw-hdep.o
 			;;
+aarch64-*-mingw32*)	gdb_host=mingw
+			gdb_host_obs=mingw-hdep.o
+			;;
 i[34567]86-*-msdosdjgpp*) gdb_host=go32 ;;
 i[34567]86-*-linux*)	gdb_host=linux ;;
 i[34567]86-*-gnu*)	gdb_host=i386gnu ;;
